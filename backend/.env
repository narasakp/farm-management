# Database Configuration for Testing
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=farm_management_test

# JWT Secrets (for testing only - change in production!)
JWT_SECRET=test-jwt-secret-key-for-development-only-min-32-chars
JWT_REFRESH_SECRET=test-refresh-secret-key-for-development-only-min-32-chars

# Server Configuration
PORT=3000
NODE_ENV=development

# Security Settings
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=30
TOKEN_EXPIRE_HOURS=1
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins
CORS_ORIGINS=http://localhost:8100,http://localhost:8097,http://localhost:8096,http://localhost:8086

# Email Configuration (for OTP sending)
EMAIL_USER=narasakp@gmail.com
EMAIL_PASS=your-app-password-here
EMAIL_FROM=narasakp@gmail.com

# SMS Configuration (Optional - ปิดไว้จนกว่าจะพร้อม)
SMS_ENABLED=false
SMS_API_KEY=
SMS_API_SECRET=

# Feature Flags
FEATURE_REQUEST_CALLBACK=false
