#!/bin/bash
# Pre-commit hook to prevent duplicate screen creation

echo "🔍 Checking for new screens..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=A)

# Check for new screen files
NEW_SCREENS=$(echo "$STAGED_FILES" | grep -E "lib/screens/.*_screen\.dart$")

if [ -n "$NEW_SCREENS" ]; then
    echo ""
    echo "⚠️  WARNING: New screen file(s) detected!"
    echo ""
    echo "$NEW_SCREENS"
    echo ""
    echo "📋 MANDATORY CHECKLIST:"
    echo ""
    echo "  1. ✅ Did you check SCREEN_INVENTORY.md?"
    echo "  2. ✅ Does similar screen already exist?"
    echo "  3. ✅ Can you add to existing screen instead?"
    echo "  4. ✅ Did you update SCREEN_INVENTORY.md?"
    echo "  5. ✅ Did you update AdminNavigationConfig (if admin)?"
    echo ""
    echo "📚 Reference: D:/Code/farm/SCREEN_INVENTORY.md"
    echo ""
    
    # Check if SCREEN_INVENTORY.md was updated
    INVENTORY_UPDATED=$(echo "$STAGED_FILES" | grep "SCREEN_INVENTORY.md")
    
    if [ -z "$INVENTORY_UPDATED" ]; then
        echo "❌ ERROR: SCREEN_INVENTORY.md was NOT updated!"
        echo ""
        echo "You MUST update SCREEN_INVENTORY.md when adding new screens."
        echo ""
        echo "To bypass this check (NOT recommended):"
        echo "  git commit --no-verify"
        echo ""
        exit 1
    fi
    
    echo "✅ SCREEN_INVENTORY.md was updated - Good!"
    echo ""
fi

# Check for duplicate routes in main.dart
MAIN_DART_STAGED=$(echo "$STAGED_FILES" | grep "lib/main.dart")

if [ -n "$MAIN_DART_STAGED" ]; then
    echo "🔍 Checking for duplicate routes..."
    
    # Extract routes and check for duplicates
    ROUTES=$(grep -o "path: '[^']*'" lib/main.dart | sort)
    DUPLICATES=$(echo "$ROUTES" | uniq -d)
    
    if [ -n "$DUPLICATES" ]; then
        echo ""
        echo "❌ ERROR: Duplicate routes found in lib/main.dart!"
        echo ""
        echo "$DUPLICATES"
        echo ""
        echo "Please remove duplicate routes before committing."
        exit 1
    fi
fi

echo "✅ Pre-commit checks passed!"
echo ""
exit 0
